{
  "folders": [
    {
      "name": "WorkNew public plugin",
      "path": "."
    }
  ],
  "settings": {
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/.local": true
    },
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Validate plugins",
        "type": "process",
        "command": "${workspaceFolder}/.venv/bin/python",
        "args": [
          "-m",
          "worknew_plugins",
          "validate"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "Test plugins",
        "type": "process",
        "command": "${workspaceFolder}/.venv/bin/python",
        "args": [
          "-m",
          "unittest",
          "discover",
          "-s",
          "tests",
          "-v"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "Build skill packages",
        "type": "process",
        "command": "${workspaceFolder}/.venv/bin/python",
        "args": [
          "-m",
          "worknew_plugins",
          "build",
          "--skills-only"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      }
    ]
  }
}
